#!/bin/bash
# ------------------------------------------------------------
# Infraestructura 1 - Matrícula 20252241
# Prueba de conectividad del Usuario hacia el Servidor Web
# Ejecutar en: Ubuntu USUARIO
# Uso: ./01-prueba-conectividad.sh [10.22.41.130]
# ------------------------------------------------------------
SERVER=${1:-10.22.41.130}

echo "=============================================="
echo " Fecha y hora: 
echo "=============================================="

echo ""
echo "== 1. IP del usuario (DHCP) =="
ip -4 a show ens3

echo ""
echo "== 2. Ping hacia $SERVER =="
ping -c 3 "$10.22.41.130"

echo ""
echo "== 3. Traceroute hacia $10.22.41.130"
traceroute -n "$10.22.41.130"

echo ""
echo "== 4. HTTPS hacia $SERVER =="
curl -k --max-time 5 -s -o /dev/null -w "Codigo HTTP: %{http_code}\n" "https://$SERVER" \
  || echo "Sin respuesta HTTPS (la VPN podria estar caida)"
